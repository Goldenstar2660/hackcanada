{
  "name": "@binsight/backend-functions",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "dev": "node ../../node_modules/typescript/bin/tsc -w -p tsconfig.json --preserveWatchOutput",
    "deploy:functions": "node ../../scripts/firebase-cli.mjs deploy --config ../../firebase.json --only functions:backend-functions",
    "lint": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "seed:demo": "node scripts/seed-demo-data.mjs"
  },
  "dependencies": {
    "@binsight/contracts": "workspace:*",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1"
  },
  "engines": {
    "node": "20"
  }
}