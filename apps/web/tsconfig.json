{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@binsight/analytics": ["../../packages/analytics/src/index.ts"],
      "@binsight/backend-functions": ["../../services/backend-functions/src/index.ts"],
      "@binsight/contracts": ["../../packages/contracts/src/index.d.ts"],
      "@binsight/rules": ["../../packages/rules/src/index.ts"],
      "@binsight/tooling": ["../../packages/tooling/src/index.ts"],
      "@binsight/web": ["./src/index.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"]
}