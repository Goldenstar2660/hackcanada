STATION_ID=demo-station-001
RULES_PRESET_ID=demo-canada-ottawa
RULES_PRESET_VERSION=1.0.0
# Item identification runs from the checked-in item_classification model bundle.
ITEM_CLASSIFIER_MODEL_DIR=models/item_classification
# Hand-zone inference runs from hand_location, while hand presence still comes from ESP telemetry.
HAND_LOCATION_MODEL_DIR=models/hand_location
ESP_ENDPOINT=http://192.168.4.1
BINSIGHT_FIREBASE_PROJECT_ID=binsight-demo
FIREBASE_FUNCTIONS_REGION=us-central1
FIREBASE_FUNCTIONS_BASE_URL=
BINSIGHT_DEVICE_ID=pi-demo-001
BINSIGHT_DEVICE_SHARED_SECRET=replace-with-demo-secret
BINSIGHT_PUBLICATION_TIMEOUT_SECONDS=5.0
DISPOSAL_TIMEOUT_SECONDS=12.0
RESET_COOLDOWN_SECONDS=1.5
CAMERA_CAPTURE_WIDTH=640
CAMERA_CAPTURE_HEIGHT=480
CAMERA_CAPTURE_FORMAT=jpg
CAMERA_CAPTURE_ROTATION_DEGREES=180
