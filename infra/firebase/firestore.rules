rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticatedOperator() {
      return request.auth != null;
    }

    match /stationLiveStatus/{stationId} {
      allow read: if isAuthenticatedOperator();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}