{
  "name": "binsight",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.6.3",
  "scripts": {
    "backend:build": "corepack pnpm --filter @binsight/backend-functions run build",
    "backend:seed:demo": "corepack pnpm --filter @binsight/backend-functions run seed:demo",
    "build": "corepack pnpm -r run build",
    "firebase:deploy:firestore": "node scripts/firebase-cli.mjs deploy --config infra/firebase/firebase.json --only firestore:rules,firestore:indexes",
    "firebase:deploy:functions": "corepack pnpm --filter @binsight/backend-functions run deploy:functions",
    "lint": "corepack pnpm -r run lint",
    "test": "corepack pnpm -r --if-present run test",
    "web:dev": "corepack pnpm --filter @binsight/web run dev"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}