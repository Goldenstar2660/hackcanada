{
  "name": "binsight",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.6.3",
  "scripts": {
    "backend:build": "node scripts/pnpm-cli.mjs --filter @binsight/backend-functions run build",
    "backend:seed:demo": "node scripts/pnpm-cli.mjs --filter @binsight/backend-functions run seed:demo",
    "build": "node scripts/pnpm-cli.mjs -r run build",
    "firebase:deploy:firestore": "node scripts/firebase-cli.mjs deploy --config firebase.json --only firestore:rules,firestore:indexes",
    "firebase:deploy:functions": "node scripts/firebase-cli.mjs deploy --config firebase.json --only functions:backend-functions",
    "lint": "node scripts/pnpm-cli.mjs -r run lint",
    "test": "node scripts/pnpm-cli.mjs -r --if-present run test",
    "web:build": "node scripts/pnpm-cli.mjs --filter @binsight/web run build",
    "web:dev": "node scripts/pnpm-cli.mjs --filter @binsight/web run dev"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}