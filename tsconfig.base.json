{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@binbuddy/analytics": ["packages/analytics/src/index.ts"],
      "@binbuddy/backend-functions": ["services/backend-functions/src/index.ts"],
      "@binbuddy/contracts": ["packages/contracts/src/index.d.ts"],
      "@binbuddy/rules": ["packages/rules/src/index.ts"],
      "@binbuddy/tooling": ["packages/tooling/src/index.ts"],
      "@binbuddy/web": ["apps/web/src/index.ts"]
    },
    "lib": ["ES2022"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmitOnError": true
  }
}